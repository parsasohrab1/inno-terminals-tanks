{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--port", "8010", "--host", "127.0.0.1"],
      "cwd": "backend",
      "port": 8010
    },
    {
      "name": "frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "--port", "5173", "--host", "127.0.0.1"],
      "cwd": "frontend",
      "port": 5173,
      "url": "http://127.0.0.1:5173"
    }
  ]
}
