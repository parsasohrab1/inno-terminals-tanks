# Copy to .env and adjust. All backend vars are prefixed INNO_.

INNO_ENVIRONMENT=development
INNO_DEBUG=true

# Database — dev uses local SQLite by default. For production point at TimescaleDB:
# INNO_DATABASE_URL=postgresql+psycopg://inno:inno@timescaledb:5432/inno

# Auth
INNO_SECRET_KEY=change-me-to-a-random-32+-byte-string
INNO_ACCESS_TOKEN_EXPIRE_MINUTES=480
INNO_REQUIRE_MFA=false

# --- Proprietary IP vault (patentable modules, appendix 5.3) ---
# Set this ONLY on trusted deployments / key-holder dev machines.
# Leave unset for teammates who should not see the patented algorithms —
# the platform still runs with open baseline algorithms.
# INNO_IP_KEY=your-long-secret-passphrase

# Leak prediction
INNO_LEAK_HORIZON_MINUTES=30

# Frontend (Vite)
VITE_API_BASE=http://localhost:8000
